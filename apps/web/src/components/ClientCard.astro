---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { labelForPlatform } from '@jellyfindex/schema';
import AbandonedBadge from '@/components/badges/AbandonedBadge.astro';
import BetaBadge from '@/components/badges/BetaBadge.astro';
import MusicBadge from '@/components/badges/MusicBadge.astro';
import NewBadge from '@/components/badges/NewBadge.astro';
import OfficialBadge from '@/components/badges/OfficialBadge.astro';
import OpenSourceBadge from '@/components/badges/OpenSourceBadge.astro';
import PricingBadge from '@/components/badges/PricingBadge.astro';
import RepoStat from '@/components/RepoStat.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

interface Props {
    client: CollectionEntry<'clients'>['data'];
    id: CollectionEntry<'clients'>['id'];
}

const { client, id } = Astro.props;

const maxPlatforms = 4;
const visiblePlatforms = client.platforms.slice(0, maxPlatforms);
const extraPlatformCount = client.platforms.length - visiblePlatforms.length;
---

<Card className="flex h-full flex-col gap-0 pt-0">
    <a href={'/clients/' + id} class="relative">
        {
            client.banner ? (
                <Image
                    src={client.banner}
                    alt=""
                    width={400}
                    height={96}
                    class="h-20 w-full object-cover"
                />
            ) : (
                <div class="h-20 w-full bg-muted/50" />
            )
        }
        <Image
            src={client.logo}
            alt=""
            width={48}
            height={48}
            class="absolute -bottom-6 left-4 size-12 rounded-lg bg-card object-contain shadow-md ring-4 ring-card"
        />
    </a>
    <CardHeader className="gap-1 pt-8">
        <div class="min-w-0">
            <CardTitle className="truncate flex items-center gap-1">
                <a href={'/clients/' + id} class="truncate hover:underline">
                    {client.name}
                </a>
                <OfficialBadge official={client.official} class="ml-auto shrink-0" />
            </CardTitle>
            <CardDescription className="truncate">
                {
                    client.developerGithub ? (
                        <a
                            href={`/authors/${client.developerGithub.toLowerCase()}`}
                            class="hover:text-foreground hover:underline"
                        >
                            {client.developerName}
                        </a>
                    ) : (
                        client.developerName
                    )
                }
            </CardDescription>
        </div>
    </CardHeader>

    <CardContent className="flex flex-1 flex-col gap-3">
        <RepoStat collection="clients" id={id} class="mt-1" />
        <p class="text-sm text-muted-foreground">{client.shortDescription}</p>
        <div class="flex flex-wrap gap-1.5">
            <NewBadge dateCreated={client.dateCreated} />
            <AbandonedBadge abandoned={client.abandoned} />
            <BetaBadge beta={client.beta} />
            <OpenSourceBadge openSource={client.openSource} />
            <MusicBadge music={client.music} />
            <PricingBadge pricing={client.pricing} />
        </div>
        <div class="flex flex-wrap gap-1.5">
            {
                visiblePlatforms.map((platform) => (
                    <a href={`/platforms/${platform}`}>
                        <Badge variant="outline" className="text-xs">
                            {labelForPlatform(platform)}
                        </Badge>
                    </a>
                ))
            }
            {
                extraPlatformCount > 0 && (
                    <Badge variant="outline" className="text-xs">
                        +{extraPlatformCount} more
                    </Badge>
                )
            }
        </div>
    </CardContent>
</Card>
