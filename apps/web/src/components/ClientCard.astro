---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { BadgeCheck, GitFork, Music, FlaskConical, Ghost, Lock, DollarSign } from 'lucide-react';
import { labelForPlatform } from '@jellyfindex/schema';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

interface Props {
    client: CollectionEntry<'clients'>['data'];
    id: CollectionEntry<'clients'>['id'];
}

const { client, id } = Astro.props;

const maxPlatforms = 4;
const visiblePlatforms = client.platforms.slice(0, maxPlatforms);
const extraPlatformCount = client.platforms.length - visiblePlatforms.length;
---

<Card className="flex h-full flex-col gap-0 pt-0">
    <div class="relative">
        {
            client.banner ? (
                <Image
                    src={client.banner}
                    alt=""
                    width={400}
                    height={96}
                    class="h-20 w-full object-cover"
                />
            ) : (
                <div class="h-20 w-full bg-muted/50" />
            )
        }
        <Image
            src={client.logo}
            alt=""
            width={48}
            height={48}
            class="absolute -bottom-6 left-4 size-12 rounded-lg bg-card object-contain shadow-md ring-4 ring-card"
        />
    </div>
    <CardHeader className="gap-1 pt-8">
        <div class="min-w-0">
            <CardTitle className="truncate flex items-center gap-1">
                <a href={'/clients/' + id} class="truncate hover:underline">
                    {client.name}
                </a>
                {
                    client.official && (
                        <Badge variant="default" className="ml-auto shrink-0">
                            <BadgeCheck className="size-3" />
                            Official
                        </Badge>
                    )
                }
            </CardTitle>
            <CardDescription className="truncate">{client.developerName}</CardDescription>
        </div>
    </CardHeader>

    <CardContent className="flex flex-1 flex-col gap-3">
        <p class="text-sm text-muted-foreground">{client.shortDescription}</p>
        <div class="flex flex-wrap gap-1.5">
            {
                client.abandoned === true && (
                    <Badge variant="secondary" className="text-xs dark:bg-yellow-900 bg-yellow-400">
                        <Ghost className="size-3" />
                        Abandoned
                    </Badge>
                )
            }
            {
                client.beta === true && (
                    <Badge variant="secondary" className="text-xs dark:bg-indigo-500 bg-indigo-300">
                        <FlaskConical className="size-3" />
                        Beta
                    </Badge>
                )
            }
            {
                client.openSource ? (
                    <Badge variant="secondary" className="text-xs">
                        <GitFork className="size-3" />
                        Open source
                    </Badge>
                ) : (
                    <Badge variant="secondary" className="text-xs">
                        <Lock className="size-3" />
                        Closed source
                    </Badge>
                )
            }
            {
                client.music === 'main' && (
                    <Badge variant="secondary" className="text-xs">
                        <Music className="size-3" />
                        Music Client
                    </Badge>
                )
            }
            {
                client.pricing === 'subscription' && (
                    <Badge variant="secondary" className="text-xs">
                        <DollarSign className="size-3" />
                        Subscription
                    </Badge>
                )
            }
            {
                client.pricing === 'one-time-purchase' && (
                    <Badge variant="secondary" className="text-xs">
                        <DollarSign className="size-3" />
                        One-time purchase
                    </Badge>
                )
            }
        </div>
        <div class="flex flex-wrap gap-1.5">
            {
                visiblePlatforms.map((platform) => (
                    <Badge variant="outline" className="text-xs">
                        {labelForPlatform(platform)}
                    </Badge>
                ))
            }
            {
                extraPlatformCount > 0 && (
                    <Badge variant="outline" className="text-xs">
                        +{extraPlatformCount} more
                    </Badge>
                )
            }
        </div>
    </CardContent>
</Card>
