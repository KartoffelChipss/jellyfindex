---
import { Blocks, Menu, Paintbrush, Smartphone, X } from 'lucide-react';
import GitHub from '@/components/icons/GitHub.astro';

const REPO_URL = 'https://github.com/KartoffelChipss/jellyfindex';

const links = [
    { href: '/clients', label: 'Clients', Icon: Smartphone },
    { href: '/plugins', label: 'Plugins', Icon: Blocks },
    { href: '/themes', label: 'Themes', Icon: Paintbrush },
];
---

<header class="sticky top-4 z-10 mx-auto mb-6 w-full max-w-6xl px-4">
    <nav class="rounded-2xl border bg-card/50 shadow-sm backdrop-blur sm:rounded-full">
        <div class="flex items-center justify-between gap-4 px-5 py-3">
            <a href="/" class="flex items-center gap-2 font-heading text-sm font-semibold">
                jellyfindex
            </a>
            <div class="hidden items-center gap-6 sm:flex">
                {
                    links.map(({ href, label, Icon }) => (
                        <a
                            href={href}
                            class="flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
                        >
                            <Icon className="size-4" />
                            {label}
                        </a>
                    ))
                }
            </div>
            <a
                href={REPO_URL}
                target="_blank"
                rel="noreferrer"
                class="hidden items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground sm:flex"
            >
                <GitHub class="size-4" />
                GitHub
            </a>
            <button
                id="nav-toggle"
                type="button"
                aria-label="Toggle menu"
                aria-expanded="false"
                aria-controls="nav-panel"
                class="flex size-8 items-center justify-center text-muted-foreground transition-colors hover:text-foreground sm:hidden"
            >
                <Menu id="nav-menu-icon" className="size-5" />
                <X id="nav-close-icon" className="hidden size-5" />
            </button>
        </div>
        <div id="nav-panel" class="hidden flex-col gap-1 border-t px-3 py-3 sm:hidden">
            {
                links.map(({ href, label, Icon }) => (
                    <a
                        href={href}
                        class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                    >
                        <Icon className="size-4" />
                        {label}
                    </a>
                ))
            }
            <a
                href={REPO_URL}
                target="_blank"
                rel="noreferrer"
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
            >
                <GitHub class="size-4" />
                GitHub
            </a>
        </div>
    </nav>
</header>

<script>
    const toggle = document.querySelector<HTMLButtonElement>('#nav-toggle');
    const panel = document.querySelector<HTMLDivElement>('#nav-panel');
    const menuIcon = document.querySelector<HTMLElement>('#nav-menu-icon');
    const closeIcon = document.querySelector<HTMLElement>('#nav-close-icon');

    function setOpen(open: boolean) {
        panel?.classList.toggle('hidden', !open);
        panel?.classList.toggle('flex', open);
        menuIcon?.classList.toggle('hidden', open);
        closeIcon?.classList.toggle('hidden', !open);
        toggle?.setAttribute('aria-expanded', String(open));
    }

    toggle?.addEventListener('click', () => {
        setOpen(panel?.classList.contains('hidden') ?? false);
    });

    panel?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
    });
</script>
