---
const REPO_URL = 'https://github.com/KartoffelChipss/jellyfindex';
---

<header class="sticky top-4 z-10 mx-auto mb-6 max-w-6xl px-4">
    <nav
        class="flex items-center justify-between gap-4 rounded-full border bg-card/50 px-4 py-2 shadow-sm backdrop-blur"
    >
        <a href="/" class="flex items-center gap-2 font-heading text-sm font-semibold">
            jellyfindex
        </a>
        <div class="flex items-center gap-4">
            <a
                href="/clients"
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
                Clients
            </a>
            <a
                href="/plugins"
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
                Plugins
            </a>
            <a
                href="/themes"
                class="text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
                Themes
            </a>
        </div>
        <a
            href={REPO_URL}
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
            <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
                <path
                    d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.58.24 2.75.12 3.04.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.08.78 2.17 0 1.56-.01 2.83-.01 3.21 0 .3.2.66.79.55A10.75 10.75 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
                ></path>
            </svg>
            GitHub
        </a>
    </nav>
</header>
