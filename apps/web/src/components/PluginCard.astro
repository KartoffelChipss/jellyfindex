---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { labelForPluginCategory } from '@jellyfindex/schema';
import AbandonedBadge from '@/components/badges/AbandonedBadge.astro';
import BetaBadge from '@/components/badges/BetaBadge.astro';
import OfficialBadge from '@/components/badges/OfficialBadge.astro';
import OpenSourceBadge from '@/components/badges/OpenSourceBadge.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

interface Props {
    plugin: CollectionEntry<'plugins'>['data'];
    id: CollectionEntry<'plugins'>['id'];
}

const { plugin, id } = Astro.props;

const maxCategories = 4;
const visibleCategories = plugin.categories.slice(0, maxCategories);
const extraCategoryCount = plugin.categories.length - visibleCategories.length;
---

<Card className="flex h-full flex-col gap-0 pt-0">
    <div class="relative">
        {
            plugin.banner ? (
                <Image
                    src={plugin.banner}
                    alt=""
                    width={400}
                    height={96}
                    class="h-20 w-full object-cover"
                />
            ) : (
                <div class="h-20 w-full bg-muted/50" />
            )
        }
        <Image
            src={plugin.logo}
            alt=""
            width={48}
            height={48}
            class="absolute -bottom-6 left-4 size-12 rounded-lg bg-card object-contain shadow-md ring-4 ring-card"
        />
    </div>
    <CardHeader className="gap-1 pt-8">
        <div class="min-w-0">
            <CardTitle className="truncate flex items-center gap-1">
                <a href={'/plugins/' + id} class="truncate hover:underline">
                    {plugin.name}
                </a>
                <OfficialBadge official={plugin.official} class="ml-auto shrink-0" />
            </CardTitle>
            <CardDescription className="truncate">
                {
                    plugin.developerGithub ? (
                        <a
                            href={`/authors/${plugin.developerGithub.toLowerCase()}`}
                            class="hover:text-foreground hover:underline"
                        >
                            {plugin.developerName}
                        </a>
                    ) : (
                        plugin.developerName
                    )
                }
            </CardDescription>
        </div>
    </CardHeader>

    <CardContent className="flex flex-1 flex-col gap-3">
        <p class="text-sm text-muted-foreground">{plugin.shortDescription}</p>
        <div class="flex flex-wrap gap-1.5">
            <AbandonedBadge abandoned={plugin.abandoned} />
            <BetaBadge beta={plugin.beta} />
            <OpenSourceBadge openSource={plugin.openSource} />
        </div>
        <div class="flex flex-wrap gap-1.5">
            {
                visibleCategories.map((category) => (
                    <Badge variant="outline" className="text-xs">
                        {labelForPluginCategory(category)}
                    </Badge>
                ))
            }
            {
                extraCategoryCount > 0 && (
                    <Badge variant="outline" className="text-xs">
                        +{extraCategoryCount} more
                    </Badge>
                )
            }
        </div>
    </CardContent>
</Card>
