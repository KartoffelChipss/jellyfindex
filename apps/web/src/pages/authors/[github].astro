---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { ArrowLeft } from 'lucide-react';
import ClientCard from '@/components/ClientCard.astro';
import PluginCard from '@/components/PluginCard.astro';
import ThemeCard from '@/components/ThemeCard.astro';
import GitHubIcon from '@/components/icons/GitHub.astro';
import { buttonVariants } from '@/components/ui/button';
import Layout from '@/layouts/Layout.astro';

export const getStaticPaths = (async () => {
    const clients = await getCollection('clients');
    const plugins = await getCollection('plugins');
    const themes = await getCollection('themes');

    const githubs = new Map<string, string>();
    for (const entry of [...clients, ...plugins, ...themes]) {
        const gh = entry.data.developerGithub;
        if (!gh) continue;
        const key = gh.toLowerCase();
        if (!githubs.has(key)) githubs.set(key, gh);
    }

    return Array.from(githubs.entries()).map(([key, github]) => ({
        params: { github: key },
        props: {
            github,
            clients: clients.filter((entry) => entry.data.developerGithub?.toLowerCase() === key),
            plugins: plugins.filter((entry) => entry.data.developerGithub?.toLowerCase() === key),
            themes: themes.filter((entry) => entry.data.developerGithub?.toLowerCase() === key),
        },
    }));
}) satisfies GetStaticPaths;

interface Props {
    github: string;
    clients: CollectionEntry<'clients'>[];
    plugins: CollectionEntry<'plugins'>[];
    themes: CollectionEntry<'themes'>[];
}

const { github, clients, plugins, themes } = Astro.props;

const developerName =
    clients[0]?.data.developerName ??
    plugins[0]?.data.developerName ??
    themes[0]?.data.developerName ??
    github;
const total = clients.length + plugins.length + themes.length;
---

<Layout
    title={`${developerName} — jellyfindex`}
    description={`Jellyfin clients, plugins, and themes by ${developerName} on jellyfindex.`}
>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <a
            href="/"
            class="mb-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
            <ArrowLeft className="size-4" />
            Home
        </a>

        <header class="mb-10 flex flex-wrap items-center gap-4">
            <img
                src={`https://github.com/${github}.png?size=128`}
                alt={developerName}
                width={64}
                height={64}
                class="size-16 shrink-0 rounded-full ring-1 ring-foreground/10"
            />
            <div class="min-w-0 flex-1">
                <h1 class="font-heading text-2xl font-semibold tracking-tight">
                    {developerName}
                </h1>
                <p class="mt-1 text-sm text-muted-foreground">
                    {total} project{total === 1 ? '' : 's'} on jellyfindex
                </p>
            </div>
            <a
                href={`https://github.com/${github}`}
                target="_blank"
                rel="noreferrer"
                class={buttonVariants({ variant: 'outline', size: 'sm' })}
            >
                <GitHubIcon class="size-4" />
                @{github}
            </a>
        </header>

        {
            clients.length > 0 && (
                <section class="mb-12">
                    <h2 class="mb-4 font-heading text-lg font-semibold">
                        Clients ({clients.length})
                    </h2>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        {clients.map((entry) => (
                            <ClientCard client={entry.data} id={entry.id} />
                        ))}
                    </div>
                </section>
            )
        }

        {
            plugins.length > 0 && (
                <section class="mb-12">
                    <h2 class="mb-4 font-heading text-lg font-semibold">
                        Plugins ({plugins.length})
                    </h2>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        {plugins.map((entry) => (
                            <PluginCard plugin={entry.data} id={entry.id} />
                        ))}
                    </div>
                </section>
            )
        }

        {
            themes.length > 0 && (
                <section class="mb-12">
                    <h2 class="mb-4 font-heading text-lg font-semibold">
                        Themes ({themes.length})
                    </h2>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        {themes.map((entry) => (
                            <ThemeCard theme={entry.data} id={entry.id} />
                        ))}
                    </div>
                </section>
            )
        }
    </div>
</Layout>
