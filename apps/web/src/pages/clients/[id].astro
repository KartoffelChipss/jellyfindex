---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { ArrowLeft, Download, Sparkles } from 'lucide-react';
import {
    FEATURE_FLAG_MAP,
    LINK_TYPES,
    PLATFORM_CATEGORIES,
    categoryForPlatform,
    labelForPlatform,
    type LinkType,
} from '@jellyfindex/schema';
import AbandonedBadge from '@/components/badges/AbandonedBadge.astro';
import BetaBadge from '@/components/badges/BetaBadge.astro';
import LicenseBadge from '@/components/badges/LicenseBadge.astro';
import MusicBadge from '@/components/badges/MusicBadge.astro';
import NewBadge from '@/components/badges/NewBadge.astro';
import OfficialBadge from '@/components/badges/OfficialBadge.astro';
import OpenSourceBadge from '@/components/badges/OpenSourceBadge.astro';
import PricingBadge from '@/components/badges/PricingBadge.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { InstallTabs } from '@/components/InstallTabs';
import { PreviewCarousel } from '@/components/PreviewCarousel';
import ReportButton from '@/components/ReportButton.astro';
import { iconForLink } from '@/lib/link-icons';
import Layout from '@/layouts/Layout.astro';

export const getStaticPaths = (async () => {
    const entries = await getCollection('clients');
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}) satisfies GetStaticPaths;

interface Props {
    entry: CollectionEntry<'clients'>;
}

const { entry } = Astro.props;
const client = entry.data;
const { Content } = await render(entry);

function humanize(value: string) {
    return value.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

const platformsByCategory = new Map<string, { id: string; label: string }[]>();
for (const platform of client.platforms) {
    const categoryLabel = PLATFORM_CATEGORIES[categoryForPlatform(platform)].label;
    const list = platformsByCategory.get(categoryLabel) ?? [];
    list.push({ id: platform, label: labelForPlatform(platform) });
    platformsByCategory.set(categoryLabel, list);
}

const featuresByCategory = new Map<string, string[]>();
for (const [flagId, enabled] of Object.entries(client.features)) {
    if (!enabled) continue;
    const def = FEATURE_FLAG_MAP.get(flagId);
    if (!def) continue;
    const list = featuresByCategory.get(def.category) ?? [];
    list.push(def.displayName);
    featuresByCategory.set(def.category, list);
}

const otherLinks = client.links.filter((link) => link !== client.installationLink);

const instructionPlatforms = client.platforms
    .filter((platform) => client.installationInstructions?.[platform])
    .map((platform) => ({
        value: platform,
        label: labelForPlatform(platform),
        html: client.installationInstructionsHtml[platform] ?? '',
    }));

const dateAdded = new Date(client.dateAdded).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const dateCreated = client.dateCreated
    ? new Date(client.dateCreated).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })
    : undefined;

const relatedPlugins = (
    await Promise.all(client.relatedPlugins.map((id) => getEntry('plugins', id)))
).filter((entry) => entry !== undefined);

const previewImages = await Promise.all(
    client.previewImages.map(async (entry) => {
        const isObject = entry !== null && typeof entry === 'object' && 'image' in entry;
        const image = isObject ? entry.image : entry;
        const title = isObject ? entry.title : undefined;
        const platform = isObject ? entry.platform : undefined;
        const optimized = await getImage({ src: image, height: 512 });
        return {
            src: optimized.src,
            width: optimized.attributes.width,
            height: optimized.attributes.height,
            title:
                [title, platform ? labelForPlatform(platform) : undefined]
                    .filter(Boolean)
                    .join(' · ') || undefined,
        };
    })
);
---

<Layout title={`${client.name} — jellyfindex`} description={client.shortDescription}>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <a
            href="/clients"
            class="mb-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
            <ArrowLeft className="size-4" />
            All clients
        </a>

        {
            client.banner && (
                <Image
                    src={client.banner}
                    alt={client.name + ' banner'}
                    width={1200}
                    height={400}
                    loading="eager"
                    class="mb-6 aspect-5/1 w-full rounded-xl object-cover ring-1 ring-foreground/10"
                />
            )
        }

        <header class="mb-8 flex items-start gap-4">
            <Image
                src={client.logo}
                alt={client.name + ' logo'}
                width={64}
                height={64}
                loading="eager"
                class="size-16 shrink-0 rounded-xl object-contain ring-1 ring-foreground/10"
            />
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="font-heading text-2xl font-semibold tracking-tight">
                        {client.name}
                    </h1>
                    <OfficialBadge official={client.official} />
                </div>
                <p class="mt-1 text-sm text-muted-foreground">
                    by{' '}
                    {
                        client.developerGithub ? (
                            <a
                                href={`/authors/${client.developerGithub.toLowerCase()}`}
                                class="hover:text-foreground hover:underline"
                            >
                                {client.developerName}
                            </a>
                        ) : (
                            client.developerName
                        )
                    }
                </p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                    <NewBadge dateCreated={client.dateCreated} />
                    <AbandonedBadge abandoned={client.abandoned} />
                    <BetaBadge beta={client.beta} />
                    <OpenSourceBadge openSource={client.openSource} />
                    <MusicBadge music={client.music} />
                    <PricingBadge pricing={client.pricing} />
                    <LicenseBadge license={client.license} />
                </div>
            </div>
        </header>

        <div class="mb-8 flex flex-wrap gap-2">
            {
                client.installationLink ? (
                    <a
                        href={client.installationLink.url}
                        target="_blank"
                        rel="noreferrer"
                        class={buttonVariants({ size: 'sm' })}
                    >
                        <Download />
                        Install
                    </a>
                ) : (
                    instructionPlatforms.length > 0 && (
                        <a href="#installation-instructions" class={buttonVariants({ size: 'sm' })}>
                            <Download />
                            Install
                        </a>
                    )
                )
            }
            {
                otherLinks.map((link) => {
                    const Icon = iconForLink(link.type as LinkType, false);
                    return (
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noreferrer"
                            class={buttonVariants({ size: 'sm', variant: 'outline' })}
                        >
                            <Icon />
                            {link.label ?? LINK_TYPES[link.type as LinkType].label}
                        </a>
                    );
                })
            }
        </div>

        {
            previewImages.length > 0 && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Previews</h2>
                    <PreviewCarousel client:visible images={previewImages} />
                </section>
            )
        }

        {
            client.description && (
                <>
                    <Separator className="mb-8" />
                    <div class="prose prose-sm dark:prose-invert mb-8 max-w-none">
                        <Content />
                    </div>
                </>
            )
        }

        <Separator className="mb-8" />

        <section class="mb-8">
            <h2 class="mb-3 font-heading text-lg font-semibold">Platforms</h2>
            <div class="flex flex-col gap-3">
                {
                    [...platformsByCategory.entries()].map(([category, platforms]) => (
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="w-28 shrink-0 text-sm text-muted-foreground">
                                {category}
                            </span>
                            <div class="flex flex-wrap gap-1.5">
                                {platforms.map((platform) => (
                                    <a href={`/platforms/${platform.id}`}>
                                        <Badge variant="outline" className="text-xs">
                                            {platform.label}
                                        </Badge>
                                    </a>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>

        {
            featuresByCategory.size > 0 && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Features</h2>
                    <div class="flex flex-col gap-3">
                        {[...featuresByCategory.entries()].map(([category, features]) => (
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="w-28 shrink-0 text-sm text-muted-foreground">
                                    {humanize(category)}
                                </span>
                                <div class="flex flex-wrap gap-1.5">
                                    {features.map((feature) => (
                                        <Badge variant="outline">{feature}</Badge>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </section>
            )
        }

        {
            relatedPlugins.length > 0 && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Related plugins</h2>
                    <div class="flex flex-wrap gap-2">
                        {relatedPlugins.map((related) => (
                            <a
                                href={`/plugins/${related.id}`}
                                class="flex items-center gap-2 rounded-lg border px-3 py-1.5 text-sm transition-colors hover:bg-muted/50"
                            >
                                <Image
                                    src={related.data.logo}
                                    alt=""
                                    width={20}
                                    height={20}
                                    class="size-5 shrink-0 rounded object-contain"
                                />
                                {related.data.name}
                            </a>
                        ))}
                    </div>
                </section>
            )
        }

        {
            instructionPlatforms.length > 0 && (
                <section id="installation-instructions" class="mb-8 scroll-mt-20">
                    <h2 class="mb-3 font-heading text-lg font-semibold">
                        Installation instructions
                    </h2>
                    <InstallTabs client:load platforms={instructionPlatforms} />
                </section>
            )
        }

        {
            client.aiUsed && (
                <div class="mb-8 flex items-start gap-2 rounded-lg border bg-muted/50 p-3 text-sm text-muted-foreground">
                    <Sparkles className="mt-0.5 size-4 shrink-0" />
                    <div>
                        <h3 class="mb-1 font-heading text-sm font-bold">AI-Disclosure</h3>
                        <p>
                            {client.aiDisclaimer ??
                                'This submission was written or assisted with AI.'}
                        </p>
                    </div>
                </div>
            )
        }

        <Separator className="mb-4" />
        <div class="flex items-center justify-between gap-4">
            <p class="text-xs text-muted-foreground">
                Added on {dateAdded} by {client.submittedBy}
                {dateCreated && <>· Created {dateCreated}</>}
            </p>
            <ReportButton entryType="Client" name={client.name} path={`/clients/${entry.id}`} />
        </div>
    </div>
</Layout>
