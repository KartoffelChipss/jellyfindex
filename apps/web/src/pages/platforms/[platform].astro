---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { ArrowLeft, Search } from 'lucide-react';
import {
    ALL_PLATFORMS,
    PLATFORM_CATEGORIES,
    categoryForPlatform,
    labelForPlatform,
    type Platform,
} from '@jellyfindex/schema';
import ClientCard from '@/components/ClientCard.astro';
import { Input } from '@/components/ui/input';
import Layout from '@/layouts/Layout.astro';

export const getStaticPaths = (async () => {
    const clients = (await getCollection('clients')).filter((entry) => !entry.data.abandoned);

    const withEntries = (ALL_PLATFORMS as Platform[])
        .map((platform) => ({
            platform,
            entries: clients.filter((entry) => entry.data.platforms.includes(platform)),
        }))
        .filter(({ entries }) => entries.length > 0);

    const availablePlatforms = withEntries.map(({ platform }) => platform);

    return withEntries.map(({ platform, entries }) => ({
        params: { platform },
        props: { platform, entries, availablePlatforms },
    }));
}) satisfies GetStaticPaths;

const { platform, entries, availablePlatforms } = Astro.props;
const label = labelForPlatform(platform);

const sortedEntries = [...entries].sort(
    (a, b) => new Date(b.data.dateAdded).getTime() - new Date(a.data.dateAdded).getTime()
);

const category = categoryForPlatform(platform);
const siblingPlatforms = (
    Object.keys(PLATFORM_CATEGORIES[category].platforms) as Platform[]
).filter((p) => p !== platform && availablePlatforms.includes(p));

const title = `Jellyfin clients for ${label} — jellyfindex`;
const description = `Browse ${entries.length} Jellyfin client${entries.length === 1 ? '' : 's'} available on ${label}. A community-maintained directory of Jellyfin apps.`;

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Jellyfin clients for ${label}`,
    description,
    numberOfItems: sortedEntries.length,
    itemListElement: sortedEntries.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: entry.data.name,
        url: new URL(`/clients/${entry.id}`, Astro.site).toString(),
    })),
};
---

<Layout title={title} description={description}>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    </Fragment>

    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <nav class="mb-6 flex items-center gap-1.5 text-sm text-muted-foreground">
            <a href="/clients" class="inline-flex items-center gap-1.5 hover:text-foreground">
                <ArrowLeft className="size-4" />
                All clients
            </a>
            <span aria-hidden="true">/</span>
            <a href="/platforms" class="hover:text-foreground">Platforms</a>
        </nav>

        <header class="mb-10 text-center">
            <h1 class="font-heading text-4xl font-semibold tracking-tight">
                Jellyfin clients for {label}
            </h1>
            <p class="mx-auto mt-3 max-w-xl text-balance text-muted-foreground">
                {entries.length} community-maintained Jellyfin client{
                    entries.length === 1 ? '' : 's'
                } available on {label}.
            </p>
        </header>

        <div class="mb-8 flex items-center justify-between gap-4">
            <div class="relative max-w-sm flex-1">
                <Search
                    className="pointer-events-none absolute top-1/2 left-2.5 size-4 -translate-y-1/2 text-muted-foreground"
                />
                <Input
                    id="search"
                    type="search"
                    placeholder={`Search ${label} clients…`}
                    className="pl-8"
                />
            </div>
            <p class="shrink-0 text-sm text-muted-foreground">
                {entries.length} client{entries.length === 1 ? '' : 's'}
            </p>
        </div>

        <div id="client-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
                sortedEntries.map((entry) => (
                    <div
                        data-search={`${entry.data.name} ${entry.data.developerName} ${entry.data.shortDescription}`.toLowerCase()}
                    >
                        <ClientCard client={entry.data} id={entry.id} />
                    </div>
                ))
            }
        </div>

        <p id="empty-state" class="hidden py-16 text-center text-muted-foreground">
            No clients match your search.
        </p>

        {
            siblingPlatforms.length > 0 && (
                <section class="mt-16 border-t pt-8">
                    <h2 class="mb-3 font-heading text-sm font-semibold text-muted-foreground">
                        Other {PLATFORM_CATEGORIES[category].label.toLowerCase()} platforms
                    </h2>
                    <div class="flex flex-wrap gap-2">
                        {siblingPlatforms.map((p) => (
                            <a
                                href={`/platforms/${p}`}
                                class="rounded-lg border px-3 py-1.5 text-sm transition-colors hover:bg-muted/50"
                            >
                                {labelForPlatform(p)}
                            </a>
                        ))}
                    </div>
                </section>
            )
        }
    </div>
</Layout>

<script>
    const input = document.querySelector<HTMLInputElement>('#search');
    const grid = document.querySelector<HTMLDivElement>('#client-grid');
    const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
    const cards = grid ? (Array.from(grid.children) as HTMLElement[]) : [];

    input?.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visibleCount = 0;
        for (const card of cards) {
            const matches = card.dataset.search?.includes(query) ?? true;
            card.classList.toggle('hidden', !matches);
            if (matches) visibleCount++;
        }
        emptyState?.classList.toggle('hidden', visibleCount !== 0);
    });
</script>
