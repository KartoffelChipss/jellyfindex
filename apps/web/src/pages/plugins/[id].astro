---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import {
    ArrowLeft,
    BadgeCheck,
    Download,
    GitFork,
    Scale,
    Sparkles,
    FlaskConical,
    Ghost,
    Lock,
} from 'lucide-react';
import { LINK_TYPES, labelForPluginCategory, type LinkType } from '@jellyfindex/schema';
import { Badge, badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { PreviewCarousel } from '@/components/PreviewCarousel';
import { iconForLink } from '@/lib/link-icons';
import Layout from '@/layouts/Layout.astro';

export const getStaticPaths = (async () => {
    const entries = await getCollection('plugins');
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}) satisfies GetStaticPaths;

interface Props {
    entry: CollectionEntry<'plugins'>;
}

const { entry } = Astro.props;
const plugin = entry.data;
const { Content } = await render(entry);

const otherLinks = plugin.links.filter((link) => link !== plugin.installationLink);

const dateAdded = new Date(plugin.dateAdded).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const requiredPlugins = (
    await Promise.all(plugin.requires.map((id) => getEntry('plugins', id)))
).filter((entry) => entry !== undefined);

const previewImages = await Promise.all(
    plugin.previewImages.map(async (image) => {
        const optimized = await getImage({ src: image, height: 512 });
        return {
            src: optimized.src,
            width: optimized.attributes.width,
            height: optimized.attributes.height,
        };
    })
);
---

<Layout title={`${plugin.name} — jellyfindex`} description={plugin.shortDescription}>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <a
            href="/plugins"
            class="mb-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
            <ArrowLeft className="size-4" />
            All plugins
        </a>

        {
            plugin.banner && (
                <Image
                    src={plugin.banner}
                    alt={plugin.name + ' banner'}
                    width={1200}
                    height={400}
                    loading="eager"
                    class="mb-6 aspect-5/1 w-full rounded-xl object-cover ring-1 ring-foreground/10"
                />
            )
        }

        <header class="mb-8 flex items-start gap-4">
            <Image
                src={plugin.logo}
                alt={plugin.name + ' logo'}
                width={64}
                height={64}
                loading="eager"
                class="size-16 shrink-0 rounded-xl object-contain ring-1 ring-foreground/10"
            />
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="font-heading text-2xl font-semibold tracking-tight">
                        {plugin.name}
                    </h1>
                    {
                        plugin.official && (
                            <Badge variant="default">
                                <BadgeCheck className="size-3" />
                                Official
                            </Badge>
                        )
                    }
                </div>
                <p class="mt-1 text-sm text-muted-foreground">
                    by{' '}
                    {
                        plugin.developerGithub ? (
                            <a
                                href={`/authors/${plugin.developerGithub.toLowerCase()}`}
                                class="hover:text-foreground hover:underline"
                            >
                                {plugin.developerName}
                            </a>
                        ) : (
                            plugin.developerName
                        )
                    }
                </p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                    {
                        plugin.abandoned === true && (
                            <Badge
                                variant="secondary"
                                className="text-xs dark:bg-yellow-900 bg-yellow-400"
                            >
                                <Ghost className="size-3" />
                                Abandoned
                            </Badge>
                        )
                    }
                    {
                        plugin.beta === true && (
                            <Badge
                                variant="secondary"
                                className="text-xs dark:bg-indigo-500 bg-indigo-300"
                            >
                                <FlaskConical className="size-3" />
                                Beta
                            </Badge>
                        )
                    }
                    {
                        plugin.openSource ? (
                            <Badge variant="secondary">
                                <GitFork className="size-3" />
                                Open source
                            </Badge>
                        ) : (
                            <Badge variant="secondary" className="text-xs">
                                <Lock className="size-3" />
                                Closed source
                            </Badge>
                        )
                    }
                    {
                        plugin.license &&
                            (plugin.license.url ? (
                                <a
                                    href={plugin.license.url}
                                    target="_blank"
                                    rel="noreferrer"
                                    class={badgeVariants({ variant: 'secondary' })}
                                >
                                    <Scale className="size-3" />
                                    {plugin.license.name}
                                </a>
                            ) : (
                                <Badge variant="secondary">
                                    <Scale className="size-3" />
                                    {plugin.license.name}
                                </Badge>
                            ))
                    }
                </div>
            </div>
        </header>

        <div class="mb-8 flex flex-wrap gap-2">
            {
                plugin.installationLink ? (
                    <a
                        href={plugin.installationLink.url}
                        target="_blank"
                        rel="noreferrer"
                        class={buttonVariants({ size: 'sm' })}
                    >
                        <Download />
                        Install
                    </a>
                ) : (
                    plugin.installationInstructionsHtml && (
                        <a href="#installation-instructions" class={buttonVariants({ size: 'sm' })}>
                            <Download />
                            Install
                        </a>
                    )
                )
            }
            {
                otherLinks.map((link) => {
                    const Icon = iconForLink(link.type as LinkType, false);
                    return (
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noreferrer"
                            class={buttonVariants({ size: 'sm', variant: 'outline' })}
                        >
                            <Icon />
                            {link.label ?? LINK_TYPES[link.type as LinkType].label}
                        </a>
                    );
                })
            }
        </div>

        {
            previewImages.length > 0 && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Previews</h2>
                    <PreviewCarousel client:visible images={previewImages} />
                </section>
            )
        }

        {
            plugin.description && (
                <>
                    <Separator className="mb-8" />
                    <div class="prose prose-sm dark:prose-invert mb-8 max-w-none">
                        <Content />
                    </div>
                </>
            )
        }

        <Separator className="mb-8" />

        <section class="mb-8">
            <h2 class="mb-3 font-heading text-lg font-semibold">Categories</h2>
            <div class="flex flex-wrap gap-1.5">
                {
                    plugin.categories.map((category) => (
                        <Badge variant="outline">{labelForPluginCategory(category)}</Badge>
                    ))
                }
            </div>
        </section>

        {
            requiredPlugins.length > 0 && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Requires</h2>
                    <div class="flex flex-wrap gap-2">
                        {requiredPlugins.map((required) => (
                            <a
                                href={`/plugins/${required.id}`}
                                class="flex items-center gap-2 rounded-lg border px-3 py-1.5 text-sm transition-colors hover:bg-muted/50"
                            >
                                <Image
                                    src={required.data.logo}
                                    alt=""
                                    width={20}
                                    height={20}
                                    class="size-5 shrink-0 rounded object-contain"
                                />
                                {required.data.name}
                            </a>
                        ))}
                    </div>
                </section>
            )
        }

        {
            plugin.minimumJellyfinVersion && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Compatibility</h2>
                    <p class="text-sm text-muted-foreground">
                        Requires Jellyfin {plugin.minimumJellyfinVersion} or newer.
                    </p>
                </section>
            )
        }

        {
            plugin.installationInstructionsHtml && (
                <section id="installation-instructions" class="mb-8 scroll-mt-20">
                    <h2 class="mb-3 font-heading text-lg font-semibold">
                        Installation instructions
                    </h2>
                    <div
                        class="prose prose-sm dark:prose-invert max-w-none"
                        set:html={plugin.installationInstructionsHtml}
                    />
                </section>
            )
        }

        {
            plugin.aiUsed && (
                <div class="mb-8 flex items-start gap-2 rounded-lg border bg-muted/50 p-3 text-sm text-muted-foreground">
                    <Sparkles className="mt-0.5 size-4 shrink-0" />
                    <div>
                        <h3 class="mb-1 font-heading text-sm font-bold">AI-Disclosure</h3>
                        <p>
                            {plugin.aiDisclaimer ??
                                'This submission was written or assisted with AI.'}
                        </p>
                    </div>
                </div>
            )
        }

        <Separator className="mb-4" />
        <p class="text-xs text-muted-foreground">
            Added on {dateAdded} by {plugin.submittedBy}
        </p>
    </div>
</Layout>
