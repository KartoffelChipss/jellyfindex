---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { ArrowLeft, Download } from 'lucide-react';
import {
    LINK_TYPES,
    labelForPluginCategory,
    resolvePreviewImage,
    type LinkType,
} from '@jellyfindex/schema';
import AbandonedBadge from '@/components/badges/AbandonedBadge.astro';
import BetaBadge from '@/components/badges/BetaBadge.astro';
import LicenseBadge from '@/components/badges/LicenseBadge.astro';
import NewBadge from '@/components/badges/NewBadge.astro';
import OfficialBadge from '@/components/badges/OfficialBadge.astro';
import OpenSourceBadge from '@/components/badges/OpenSourceBadge.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import AiDisclosureBox from '@/components/AiDisclosureBox.astro';
import { PreviewCarousel } from '@/components/PreviewCarousel';
import RepoStat from '@/components/RepoStat.astro';
import ReportButton from '@/components/ReportButton.astro';
import { iconForLink } from '@/lib/link-icons';
import Layout from '@/layouts/Layout.astro';

export const getStaticPaths = (async () => {
    const entries = await getCollection('plugins');
    return entries.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}) satisfies GetStaticPaths;

interface Props {
    entry: CollectionEntry<'plugins'>;
}

const { entry } = Astro.props;
const plugin = entry.data;
const { Content } = await render(entry);

const otherLinks = plugin.links.filter((link) => link !== plugin.installationLink);

const dateAdded = new Date(plugin.dateAdded).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const dateCreated = plugin.dateCreated
    ? new Date(plugin.dateCreated).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })
    : undefined;

const requiredPlugins = (
    await Promise.all(plugin.requires.map((id) => getEntry('plugins', id)))
).filter((entry) => entry !== undefined);

const relatedClients = (
    await Promise.all(plugin.relatedClients.map((id) => getEntry('clients', id)))
).filter((entry) => entry !== undefined);

const previewImages = await Promise.all(
    plugin.previewImages.map(async (entry) => {
        const { image, title } = resolvePreviewImage(entry);
        const optimized = await getImage({ src: image, height: 512 });
        return {
            src: optimized.src,
            width: optimized.attributes.width,
            height: optimized.attributes.height,
            title,
        };
    })
);
---

<Layout title={`${plugin.name} — jellyfindex`} description={plugin.shortDescription}>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <a
            href="/plugins"
            class="mb-6 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
            <ArrowLeft className="size-4" />
            All plugins
        </a>

        {
            plugin.banner && (
                <Image
                    src={plugin.banner}
                    alt={plugin.name + ' banner'}
                    width={1200}
                    height={400}
                    loading="eager"
                    class="mb-6 aspect-5/1 w-full rounded-xl object-cover ring-1 ring-foreground/10"
                />
            )
        }

        <header class="mb-8 flex items-start gap-4">
            <Image
                src={plugin.logo}
                alt={plugin.name + ' logo'}
                width={64}
                height={64}
                loading="eager"
                class="size-16 shrink-0 rounded-xl object-contain ring-1 ring-foreground/10"
            />
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="font-heading text-2xl font-semibold tracking-tight">
                        {plugin.name}
                    </h1>
                    <OfficialBadge official={plugin.official} />
                </div>
                <p class="mt-1 text-sm text-muted-foreground">
                    by{' '}
                    {
                        plugin.developerGithub ? (
                            <a
                                href={`/authors/${plugin.developerGithub.toLowerCase()}`}
                                class="hover:text-foreground hover:underline"
                            >
                                {plugin.developerName}
                            </a>
                        ) : (
                            plugin.developerName
                        )
                    }
                </p>
                <RepoStat collection="plugins" id={entry.id} class="mt-2" />
                <div class="mt-3 flex flex-wrap gap-1.5">
                    <NewBadge dateCreated={plugin.dateCreated} />
                    <AbandonedBadge abandoned={plugin.abandoned} />
                    <BetaBadge beta={plugin.beta} />
                    <OpenSourceBadge openSource={plugin.openSource} />
                    <LicenseBadge license={plugin.license} />
                </div>
            </div>
        </header>

        <div class="mb-8 flex flex-wrap gap-2">
            {
                plugin.installationLink ? (
                    <a
                        href={plugin.installationLink.url}
                        target="_blank"
                        rel="noreferrer"
                        class={buttonVariants({ size: 'sm' })}
                    >
                        <Download />
                        Install
                    </a>
                ) : (
                    plugin.installationInstructionsHtml && (
                        <a href="#installation-instructions" class={buttonVariants({ size: 'sm' })}>
                            <Download />
                            Install
                        </a>
                    )
                )
            }
            {
                otherLinks.map((link) => {
                    const Icon = iconForLink(link.type as LinkType, false);
                    return (
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noreferrer"
                            class={buttonVariants({ size: 'sm', variant: 'outline' })}
                        >
                            <Icon />
                            {link.label ?? LINK_TYPES[link.type as LinkType].label}
                        </a>
                    );
                })
            }
        </div>

        {
            previewImages.length > 0 && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Previews</h2>
                    <PreviewCarousel client:visible images={previewImages} />
                </section>
            )
        }

        {
            plugin.description && (
                <>
                    <Separator className="mb-8" />
                    <div class="prose dark:prose-invert mb-8 max-w-none">
                        <Content />
                    </div>
                </>
            )
        }

        <Separator className="mb-8" />

        <section class="mb-8">
            <h2 class="mb-3 font-heading text-lg font-semibold">Categories</h2>
            <div class="flex flex-wrap gap-1.5">
                {
                    plugin.categories.map((category) => (
                        <Badge variant="outline">{labelForPluginCategory(category)}</Badge>
                    ))
                }
            </div>
        </section>

        {
            requiredPlugins.length > 0 && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Requires</h2>
                    <div class="flex flex-wrap gap-2">
                        {requiredPlugins.map((required) => (
                            <a
                                href={`/plugins/${required.id}`}
                                class="flex items-center gap-2 rounded-lg border px-3 py-1.5 text-sm transition-colors hover:bg-muted/50"
                            >
                                <Image
                                    src={required.data.logo}
                                    alt=""
                                    width={20}
                                    height={20}
                                    class="size-5 shrink-0 rounded object-contain"
                                />
                                {required.data.name}
                            </a>
                        ))}
                    </div>
                </section>
            )
        }

        {
            relatedClients.length > 0 && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Related clients</h2>
                    <div class="flex flex-wrap gap-2">
                        {relatedClients.map((related) => (
                            <a
                                href={`/clients/${related.id}`}
                                class="flex items-center gap-2 rounded-lg border px-3 py-1.5 text-sm transition-colors hover:bg-muted/50"
                            >
                                <Image
                                    src={related.data.logo}
                                    alt=""
                                    width={20}
                                    height={20}
                                    class="size-5 shrink-0 rounded object-contain"
                                />
                                {related.data.name}
                            </a>
                        ))}
                    </div>
                </section>
            )
        }

        {
            plugin.minimumJellyfinVersion && (
                <section class="mb-8">
                    <h2 class="mb-3 font-heading text-lg font-semibold">Compatibility</h2>
                    <p class="text-sm text-muted-foreground">
                        Requires Jellyfin {plugin.minimumJellyfinVersion} or newer.
                    </p>
                </section>
            )
        }

        {
            plugin.installationInstructionsHtml && (
                <section id="installation-instructions" class="mb-8 scroll-mt-20">
                    <h2 class="mb-3 font-heading text-lg font-semibold">
                        Installation instructions
                    </h2>
                    <div
                        class="prose dark:prose-invert max-w-none"
                        set:html={plugin.installationInstructionsHtml}
                    />
                </section>
            )
        }

        <AiDisclosureBox aiUsage={plugin.aiUsage} aiDescription={plugin.aiDescription} />

        <Separator className="mb-4" />
        <div class="flex items-center justify-between gap-4">
            <p class="text-xs text-muted-foreground">
                Added on {dateAdded} by {plugin.submittedBy}
                {dateCreated && <>· Created {dateCreated}</>}
            </p>
            <ReportButton entryType="Plugin" name={plugin.name} path={`/plugins/${entry.id}`} />
        </div>
    </div>
</Layout>
