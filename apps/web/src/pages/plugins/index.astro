---
import { getCollection } from 'astro:content';
import { Search } from 'lucide-react';
import { ListFilters } from '@/components/ListFilters';
import PluginCard from '@/components/PluginCard.astro';
import { Input } from '@/components/ui/input';
import Layout from '@/layouts/Layout.astro';

const entries = (await getCollection('plugins')).sort(
    (a, b) => new Date(b.data.dateAdded).getTime() - new Date(a.data.dateAdded).getTime()
);
const defaultVisibleCount = entries.filter((entry) => !entry.data.abandoned).length;
---

<Layout
    title="Plugins — jellyfindex"
    description="A community-maintained directory of Jellyfin server plugins."
>
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <header class="mb-10 text-center">
            <h1 class="font-heading text-4xl font-semibold tracking-tight">Plugins</h1>
            <p class="mx-auto mt-3 max-w-xl text-balance text-muted-foreground">
                A community-maintained directory of Jellyfin server plugins.
            </p>
        </header>

        <div class="mb-8 flex flex-wrap items-center gap-4">
            <div class="relative min-w-50 max-w-sm flex-1">
                <Search
                    className="pointer-events-none absolute top-1/2 left-2.5 size-4 -translate-y-1/2 text-muted-foreground"
                />
                <Input id="search" type="search" placeholder="Search plugins…" className="pl-8" />
            </div>
            <ListFilters client:load />
            <p id="result-count" class="ml-auto shrink-0 text-sm text-muted-foreground">
                {defaultVisibleCount} plugin{defaultVisibleCount === 1 ? '' : 's'}
            </p>
        </div>

        <div id="plugin-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
                entries.map((entry) => (
                    <div
                        data-search={`${entry.data.name} ${entry.data.developerName} ${entry.data.shortDescription}`.toLowerCase()}
                        data-abandoned={entry.data.abandoned}
                        data-beta={entry.data.beta}
                        data-open-source={entry.data.openSource}
                        data-ai-usage={entry.data.aiUsage}
                    >
                        <PluginCard plugin={entry.data} id={entry.id} />
                    </div>
                ))
            }
        </div>

        <p id="empty-state" class="hidden py-16 text-center text-muted-foreground">
            No plugins match your search.
        </p>
    </div>
</Layout>

<script>
    import {
        DEFAULT_LIST_FILTERS,
        LIST_FILTERS_EVENT,
        type ListFiltersState,
    } from '@/components/ListFilters';

    const input = document.querySelector<HTMLInputElement>('#search');
    const grid = document.querySelector<HTMLDivElement>('#plugin-grid');
    const emptyState = document.querySelector<HTMLParagraphElement>('#empty-state');
    const resultCount = document.querySelector<HTMLParagraphElement>('#result-count');
    const cards = grid ? (Array.from(grid.children) as HTMLElement[]) : [];

    let filters: ListFiltersState = DEFAULT_LIST_FILTERS;

    function applyFilters() {
        const query = input?.value.trim().toLowerCase() ?? '';
        let visibleCount = 0;
        for (const card of cards) {
            const matchesSearch = card.dataset.search?.includes(query) ?? true;
            const isAbandoned = card.dataset.abandoned === 'true';
            const isBeta = card.dataset.beta === 'true';
            const isOpenSource = card.dataset.openSource === 'true';
            const aiUsage = card.dataset.aiUsage as keyof ListFiltersState['aiUsage'] | undefined;

            const matchesFilters =
                (!filters.hideAbandoned || !isAbandoned) &&
                (!filters.hideBeta || !isBeta) &&
                (!filters.openSourceOnly || isOpenSource) &&
                (!aiUsage || filters.aiUsage[aiUsage]);

            const visible = matchesSearch && matchesFilters;
            card.classList.toggle('hidden', !visible);
            if (visible) visibleCount++;
        }
        emptyState?.classList.toggle('hidden', visibleCount !== 0);
        if (resultCount) {
            resultCount.textContent = `${visibleCount} plugin${visibleCount === 1 ? '' : 's'}`;
        }
    }

    input?.addEventListener('input', applyFilters);
    window.addEventListener(LIST_FILTERS_EVENT, (event) => {
        filters = (event as CustomEvent<ListFiltersState>).detail;
        applyFilters();
    });

    applyFilters();
</script>
