{
    "name": "jellyfindex",
    "private": true,
    "version": "0.0.0",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "pnpm --filter web run dev",
        "build": "pnpm --filter web run build",
        "preview": "pnpm --filter web run preview",
        "validate": "pnpm --filter @jellyfindex/validate-content run validate",
        "check-abandoned": "pnpm --filter @jellyfindex/check-abandoned run check-abandoned",
        "repo-stats": "pnpm --filter @jellyfindex/repo-stats run repo-stats",
        "optimize-images": "pnpm --filter @jellyfindex/optimize-images run optimize-images",
        "schema:json": "pnpm --filter @jellyfindex/schema run schema:json",
        "schema:json:check": "pnpm run schema:json && git diff --exit-code -- packages/schema/schemas",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1"
    }
}
