{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo": {
      "type": "string"
    },
    "banner": {
      "type": "string"
    },
    "previewImages": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "image": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "image"
            ]
          }
        ]
      }
    },
    "developerName": {
      "type": "string"
    },
    "developerGithub": {
      "type": "string"
    },
    "dateAdded": {
      "type": "string",
      "format": "date"
    },
    "dateCreated": {},
    "submittedBy": {
      "type": "string"
    },
    "openSource": {
      "type": "boolean"
    },
    "license": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "shortDescription": {
      "type": "string",
      "maxLength": 250
    },
    "categories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "general",
          "metadata",
          "library",
          "integrations",
          "notifications",
          "authentication",
          "automation",
          "theme",
          "companion",
          "other"
        ]
      }
    },
    "requires": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedClients": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "official": {
      "default": false,
      "type": "boolean"
    },
    "beta": {
      "default": false,
      "type": "boolean"
    },
    "abandoned": {
      "default": false,
      "type": "boolean"
    },
    "ignoreAbandonedCheck": {
      "default": false,
      "type": "boolean"
    },
    "minimumJellyfinVersion": {
      "type": "string"
    },
    "links": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "github",
              "gitlab",
              "bitbucket",
              "sourcehut",
              "codeberg",
              "website",
              "documentation",
              "translations",
              "donation",
              "app-store",
              "google-play",
              "f-droid",
              "obtainium",
              "discord",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sourcelink": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ]
      }
    },
    "installationLink": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "bitbucket",
            "sourcehut",
            "codeberg",
            "website",
            "documentation",
            "translations",
            "donation",
            "app-store",
            "google-play",
            "f-droid",
            "obtainium",
            "discord",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourcelink": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    "installationInstructions": {
      "type": "string"
    },
    "aiUsage": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "unknown",
        "none",
        "ai-assisted",
        "vibe-coded"
      ]
    },
    "aiDescription": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "logo",
    "developerName",
    "dateAdded",
    "submittedBy",
    "openSource",
    "shortDescription",
    "categories"
  ],
  "$id": "https://jellyfindex.com/schemas/plugin.schema.json",
  "title": "Jellyfindex plugin meta.yaml"
}
