{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "previewImages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "image": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "image"
            ]
          }
        ]
      }
    },
    "developerName": {
      "type": "string"
    },
    "developerGithub": {
      "type": "string"
    },
    "dateAdded": {
      "type": "string",
      "format": "date"
    },
    "dateCreated": {},
    "submittedBy": {
      "type": "string"
    },
    "openSource": {
      "type": "boolean"
    },
    "license": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "shortDescription": {
      "type": "string",
      "maxLength": 250
    },
    "official": {
      "default": false,
      "type": "boolean"
    },
    "beta": {
      "default": false,
      "type": "boolean"
    },
    "abandoned": {
      "default": false,
      "type": "boolean"
    },
    "ignoreAbandonedCheck": {
      "default": false,
      "type": "boolean"
    },
    "links": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "github",
              "gitlab",
              "bitbucket",
              "sourcehut",
              "codeberg",
              "website",
              "documentation",
              "translations",
              "donation",
              "app-store",
              "google-play",
              "f-droid",
              "obtainium",
              "discord",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sourcelink": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "url"
        ]
      }
    },
    "installationLink": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "github",
            "gitlab",
            "bitbucket",
            "sourcehut",
            "codeberg",
            "website",
            "documentation",
            "translations",
            "donation",
            "app-store",
            "google-play",
            "f-droid",
            "obtainium",
            "discord",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sourcelink": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ]
    },
    "installationInstructions": {
      "type": "string"
    },
    "aiUsed": {
      "default": false,
      "type": "boolean"
    },
    "aiDisclaimer": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "previewImages",
    "developerName",
    "dateAdded",
    "submittedBy",
    "openSource",
    "shortDescription"
  ],
  "$id": "https://jellyfindex.com/schemas/theme.schema.json",
  "title": "Jellyfindex theme meta.yaml"
}
